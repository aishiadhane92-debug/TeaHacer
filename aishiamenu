-- AISHIA MENU
-- Roblox Studio LocalScript

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AISHIA_MENU"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Main = Instance.new("Frame")
Main.Size = UDim2.fromOffset(270, 230)
Main.Position = UDim2.new(0.5, -135, 0.5, -115)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
Main.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Main

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 45)
Title.BackgroundColor3 = Color3.fromRGB(180, 20, 40)
Title.Text = "AISHIA MENU"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.TextSize = 22
Title.Font = Enum.Font.GothamBold
Title.Parent = Main

local function createButton(name, position, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 230, 0, 42)
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = name .. " : OFF"
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Parent = Main

    Instance.new("UICorner", button)

    local enabled = false

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        button.Text = name .. (enabled and " : ON" or " : OFF")
        callback(enabled)
    end)
end

local espEnabled = false
local highlights = {}

local function updateESP(enabled)
    espEnabled = enabled

    for _, highlight in pairs(highlights) do
        highlight:Destroy()
    end
    table.clear(highlights)

    if not enabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local highlight = Instance.new("Highlight")
            highlight.FillColor = Color3.fromRGB(255, 30, 60)
            highlight.OutlineColor = Color3.new(1, 1, 1)
            highlight.Adornee = player.Character
            highlight.Parent = ScreenGui
            highlights[player] = highlight
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled then
            updateESP(true)
        end
    end)
end)

createButton("PLAYER ESP", UDim2.fromOffset(20, 65), updateESP)

createButton("AIM ASSIST SETTINGS",
    UDim2.fromOffset(20, 120),
    function(enabled)
        print("Aim assist settings:", enabled)
    end
)

createButton("CLOSE MENU", UDim2.fromOffset(20, 175), function(enabled)
    if enabled then
        ScreenGui:Destroy()
    end
end)

-- Drag functionality
local dragging = false
local dragStart, startPosition

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
